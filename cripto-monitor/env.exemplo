# Copie este arquivo para ".env" (mesma pasta) e preencha. NUNCA envie o .env para ninguém.

# Binance -> Perfil -> Gerenciamento de API -> Criar API (tipo "gerada pelo sistema").
# Marque SOMENTE "Habilitar leitura". NÃO marque Spot/Margin trading nem Saques.
# Restrinja o acesso ao IP do computador onde o monitor vai rodar.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: fale com @BotFather -> /newbot -> copie o token.
# Depois mande "oi" para o seu bot e abra https://api.telegram.org/bot<TOKEN>/getUpdates
# para ver o seu chat_id (campo "chat":{"id": ...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
